# CMake toolchain for Android (arm64-v8a): the NDK's own toolchain file plus our static prefix.
# Usage: -DCMAKE_TOOLCHAIN_FILE=toolchain-android.cmake  (ANDROID_NDK_HOME in the environment)
if(NOT ANDROID_SLICE)
  set(ANDROID_SLICE "$ENV{ANDROID_SLICE}")
endif()
if(NOT ANDROID_SLICE)
  set(ANDROID_SLICE arm64)
endif()
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
set(ANDROID_ABI arm64-v8a)
set(ANDROID_PLATFORM android-26)
set(ANDROID_STL c++_static)
set(ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES ON)   # 16 KB pages (Android 15+)
include("$ENV{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake")
set(ANDROID_PREFIX "${_root}/prefix/${ANDROID_SLICE}")
list(APPEND CMAKE_PREFIX_PATH "${ANDROID_PREFIX}")
list(INSERT CMAKE_FIND_ROOT_PATH 0 "${ANDROID_PREFIX}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_LIBDIR} "${ANDROID_PREFIX}/lib/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
set(PKG_CONFIG_USE_CMAKE_PREFIX_PATH ON)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
# never pick up host (Homebrew) libraries
set(CMAKE_IGNORE_PREFIX_PATH /opt/homebrew /usr/local)
