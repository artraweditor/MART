# CMake toolchain for iOS (device and simulator, arm64).
# Usage: -DCMAKE_TOOLCHAIN_FILE=toolchain-ios.cmake -DIOS_SLICE=device|simulator
if(NOT IOS_SLICE)
  set(IOS_SLICE "$ENV{IOS_SLICE}")
endif()
get_filename_component(_ios_root "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
set(CMAKE_SYSTEM_NAME iOS)
if(IOS_SLICE STREQUAL "simulator")
  set(CMAKE_OSX_SYSROOT iphonesimulator)
else()
  set(CMAKE_OSX_SYSROOT iphoneos)
endif()
set(CMAKE_OSX_ARCHITECTURES arm64)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_OSX_DEPLOYMENT_TARGET 16.0)
set(IOS_PREFIX "${_ios_root}/prefix/${IOS_SLICE}")
set(CMAKE_PREFIX_PATH "${IOS_PREFIX}")
set(CMAKE_FIND_ROOT_PATH "${IOS_PREFIX}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_LIBDIR} "${IOS_PREFIX}/lib/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
set(PKG_CONFIG_USE_CMAKE_PREFIX_PATH ON)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_C_FLAGS_INIT "-fPIC")
set(CMAKE_CXX_FLAGS_INIT "-fPIC")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
# never pick up host (Homebrew) libraries
set(CMAKE_IGNORE_PREFIX_PATH /opt/homebrew /usr/local)
set(CMAKE_FIND_USE_CMAKE_SYSTEM_PATH OFF)
